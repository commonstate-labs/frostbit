#!/bin/sh
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL
umask 077

SECRET_ROOT=/srv/dex-secrets
GRANT_ROOT=/run/dex-secret-grants
AUTH_KEYS=/var/lib/dex-secret-ssh/.ssh/authorized_keys
SERVICE_USER=dex-secrets
SERVICE_GROUP=dex-secrets
CONTROL=/usr/local/sbin/dex-secretctl
LOCK_ROOT=/run/dex-secretctl-lock
LOCK_FILE=$LOCK_ROOT/state.lock
MIN_TTL=10
MAX_TTL=600

usage() {
    cat >&2 <<'EOF'
Usage:
  dex-secretctl provision --miner-address fbc1... --vps-public-key FILE \
    --private-key-file FILE (--wrap-key-file FILE | --generate-wrap-key) \
    (--source-address IP_OR_CIDR | --allow-any-source)

  dex-secretctl provision --authorize-only --miner-address fbc1... \
    --vps-public-key FILE \
    (--source-address IP_OR_CIDR | --allow-any-source)

  dex-secretctl allow MINER_ADDRESS [TTL_SECONDS]
  dex-secretctl revoke MINER_ADDRESS

MINER_ADDRESS must be one canonical lowercase fbc address. TTL defaults to 120
and must be 10..600 seconds. Secret files must contain exactly 64 hexadecimal
characters. Existing signing secret files are never overwritten.
EOF
    exit 64
}

die() {
    printf 'dex-secretctl: %s\n' "$1" >&2
    exit 1
}

require_root() {
    [ "$(id -u)" -eq 0 ] || die 'must run as root'
}

require_canonical_miner_address() {
    candidate=$1
    [ "${#candidate}" -eq 43 ] || return 1
    case "$candidate" in
        fbc1*) ;;
        *) return 1 ;;
    esac
    payload=${candidate#fbc1}
    case "$payload" in
        *[!023456789acdefghjklmnpqrstuvwxyz]*) return 1 ;;
    esac
    printf '%s\n' "$candidate"
}

validate_managed_authorized_keys() {
    auth_file=$1
    awk -v control="$CONTROL" '
        function valid_address(address, payload) {
            if (length(address) != 43 || substr(address, 1, 4) != "fbc1") return 0
            payload = substr(address, 5)
            return payload !~ /[^023456789acdefghjklmnpqrstuvwxyz]/
        }
        function valid_base(options, miner_address, expected) {
            expected = "restrict,command=\"" control " fetch " miner_address "\""
            return options == expected
        }
        function valid(line, parts, count, tail, marker, marker_prefix, miner_address, rest, quote_at, source, options) {
            if (line ~ /^[[:space:]]*$/ || line ~ /^[[:space:]]*#/) return 1
            count = split(line, parts, " ssh-ed25519 ")
            if (count != 2) return 0
            count = split(parts[2], tail, /[[:space:]]+/)
            if (count != 2 || tail[1] !~ /^[A-Za-z0-9+\/=]+$/) return 0
            marker = tail[2]
            marker_prefix = "dex-secret-miner-"
            if (substr(marker, 1, length(marker_prefix)) != marker_prefix) return 0
            miner_address = substr(marker, length(marker_prefix) + 1)
            if (!valid_address(miner_address)) return 0
            options = parts[1]
            if (valid_base(options, miner_address)) return 1
            if (index(options, "from=\"") != 1) return 0
            rest = substr(options, 7)
            quote_at = index(rest, "\",")
            if (quote_at <= 1) return 0
            source = substr(rest, 1, quote_at - 1)
            if (source !~ /^[0-9A-Fa-f:.,\/]+$/) return 0
            return valid_base(substr(rest, quote_at + 2), miner_address)
        }
        !valid($0) { exit 1 }
    ' "$auth_file"
}

lock_state() {
    [ -d /run ] || die 'missing runtime directory: /run'
    [ ! -L /run ] || die 'runtime directory must not be a symlink'
    [ ! -L "$LOCK_ROOT" ] || die 'control lock directory must not be a symlink'
    install -d -o root -g root -m 0700 "$LOCK_ROOT"
    exec 9>"$LOCK_FILE"
    flock -x 9
}

audit_fetch() {
    result=$1
    connection=${SSH_CONNECTION:-}
    source_ip=${connection%% *}
    audit_miner=invalid
    if require_canonical_miner_address "${miner_address:-}" >/dev/null 2>&1; then
        audit_miner=$miner_address
    fi
    case "${kind:-}" in
        private|wrap) audit_kind=$kind ;;
        *) audit_kind=invalid ;;
    esac
    if command -v logger >/dev/null 2>&1; then
        logger -t dex-secretctl -- \
            "miner=$audit_miner kind=$audit_kind source=${source_ip:-local} result=$result" || true
    fi
}

deny_fetch() {
    audit_fetch denied
    printf '%s\n' 'secret request denied' >&2
    exit 75
}

cmd_fetch() {
    [ "$#" -eq 1 ] || deny_fetch
    [ "$(id -un)" = "$SERVICE_USER" ] || deny_fetch
    [ -n "${SSH_CONNECTION:-}" ] || deny_fetch

    miner_address=$(require_canonical_miner_address "$1") || deny_fetch
    [ -d "$SECRET_ROOT" ] || deny_fetch
    [ ! -L "$SECRET_ROOT" ] || deny_fetch
    [ -d "$SECRET_ROOT/$miner_address" ] || deny_fetch
    [ ! -L "$SECRET_ROOT/$miner_address" ] || deny_fetch
    [ -d "$GRANT_ROOT" ] || deny_fetch
    [ ! -L "$GRANT_ROOT" ] || deny_fetch
    kind=${SSH_ORIGINAL_COMMAND:-}
    case "$kind" in
        private) secret_file="$SECRET_ROOT/$miner_address/private_key.hex" ;;
        wrap) secret_file="$SECRET_ROOT/$miner_address/wrap_key.hex" ;;
        *) deny_fetch ;;
    esac

    grant_file="$GRANT_ROOT/$miner_address.expires"
    [ -f "$grant_file" ] || deny_fetch
    [ ! -L "$grant_file" ] || deny_fetch

    expires=$(cat -- "$grant_file") || deny_fetch
    case "$expires" in
        ''|*[!0-9]*) deny_fetch ;;
    esac
    now=$(date +%s) || deny_fetch
    [ "$now" -le "$expires" ] || deny_fetch

    [ -f "$secret_file" ] || deny_fetch
    [ ! -L "$secret_file" ] || deny_fetch
    secret=$(cat -- "$secret_file") || deny_fetch
    case "$secret" in
        ''|*[!0-9A-Fa-f]*) deny_fetch ;;
    esac
    [ "${#secret}" -eq 64 ] || deny_fetch

    audit_fetch issued
    printf '%s\n' "$secret"
}

cmd_allow() {
    require_root
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || usage
    miner_address=$(require_canonical_miner_address "$1") || usage
    ttl=${2:-120}
    case "$ttl" in
        ''|*[!0-9]*) usage ;;
    esac
    [ "$ttl" -ge "$MIN_TTL" ] && [ "$ttl" -le "$MAX_TTL" ] || usage
    lock_state
    [ ! -L "$SECRET_ROOT" ] || die 'secret root must not be a symlink'
    [ -d "$SECRET_ROOT/$miner_address" ] || die "unknown miner address: $miner_address"
    [ ! -L "$SECRET_ROOT/$miner_address" ] || die 'miner secret slot must not be a symlink'

    [ ! -L "$GRANT_ROOT" ] || die 'grant root must not be a symlink'
    install -d -o root -g "$SERVICE_GROUP" -m 0750 "$GRANT_ROOT"
    tmp=$(mktemp "$GRANT_ROOT/.${miner_address}.XXXXXX")
    cleanup_grant() {
        [ -n "${tmp:-}" ] && rm -f -- "$tmp"
    }
    trap cleanup_grant EXIT HUP INT TERM

    expires=$(( $(date +%s) + ttl ))
    printf '%s\n' "$expires" > "$tmp"
    chown root:"$SERVICE_GROUP" "$tmp"
    chmod 0640 "$tmp"
    mv -f -- "$tmp" "$GRANT_ROOT/$miner_address.expires"
    tmp=

    printf 'allowed %s for %s seconds (expires epoch %s)\n' "$miner_address" "$ttl" "$expires"
}

cmd_revoke() {
    require_root
    [ "$#" -eq 1 ] || usage
    miner_address=$(require_canonical_miner_address "$1") || usage
    lock_state
    [ ! -L "$GRANT_ROOT" ] || die 'grant root must not be a symlink'
    rm -f -- "$GRANT_ROOT/$miner_address.expires"
    printf 'revoked %s\n' "$miner_address"
}

require_value() {
    [ "$#" -ge 2 ] || usage
}

canonical_secret() {
    source_file=$1
    destination_file=$2
    value=$(cat -- "$source_file") || return 1
    case "$value" in
        ''|*[!0-9A-Fa-f]*) return 1 ;;
    esac
    [ "${#value}" -eq 64 ] || return 1
    printf '%s\n' "$value" > "$destination_file"
    value=
}

cmd_provision() {
    require_root

    miner_address=
    public_key_file=
    private_key_file=
    wrap_key_file=
    generate_wrap=0
    source_address=
    allow_any_source=0
    authorize_only=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --miner-address) require_value "$@"; miner_address=$2; shift 2 ;;
            --vps-public-key) require_value "$@"; public_key_file=$2; shift 2 ;;
            --private-key-file) require_value "$@"; private_key_file=$2; shift 2 ;;
            --wrap-key-file) require_value "$@"; wrap_key_file=$2; shift 2 ;;
            --generate-wrap-key) generate_wrap=1; shift ;;
            --source-address) require_value "$@"; source_address=$2; shift 2 ;;
            --allow-any-source) allow_any_source=1; shift ;;
            --authorize-only) authorize_only=1; shift ;;
            -h|--help) usage ;;
            *) usage ;;
        esac
    done

    miner_address=$(require_canonical_miner_address "$miner_address") || usage
    [ -n "$public_key_file" ] || usage
    [ -f "$public_key_file" ] || die "public key file not found: $public_key_file"
    [ ! -L "$public_key_file" ] || die 'public key file must not be a symlink'

    if [ -n "$source_address" ] && [ "$allow_any_source" -eq 1 ]; then
        usage
    fi
    if [ -z "$source_address" ] && [ "$allow_any_source" -ne 1 ]; then
        die 'use --source-address whenever the VPS has a stable address; otherwise explicitly use --allow-any-source'
    fi
    if [ -n "$source_address" ]; then
        case "$source_address" in
            *[!0-9A-Fa-f:.,/]*) die 'source address must contain only IP/CIDR characters' ;;
        esac
    fi

    nonempty_lines=$(awk 'NF { count++ } END { print count + 0 }' "$public_key_file")
    [ "$nonempty_lines" -eq 1 ] || die 'public key file must contain exactly one non-empty line'
    key_type=$(awk 'NF { print $1; exit }' "$public_key_file")
    key_blob=$(awk 'NF { print $2; exit }' "$public_key_file")
    [ "$key_type" = ssh-ed25519 ] || die 'only ssh-ed25519 VPS fetch keys are accepted'
    case "$key_blob" in
        ''|*[!A-Za-z0-9+/=]*) die 'invalid SSH public key encoding' ;;
    esac
    ssh-keygen -lf "$public_key_file" >/dev/null 2>&1 || die 'ssh-keygen rejected the VPS public key'

    lock_state

    [ ! -L "$SECRET_ROOT" ] || die 'secret root must not be a symlink'
    [ ! -L "$GRANT_ROOT" ] || die 'grant root must not be a symlink'

    auth_dir=$(dirname -- "$AUTH_KEYS")
    [ ! -L "$auth_dir" ] || die 'authorized_keys directory must not be a symlink'
    install -d -o root -g "$SERVICE_GROUP" -m 0750 "$auth_dir"
    [ ! -L "$AUTH_KEYS" ] || die 'authorized_keys must not be a symlink'
    [ -e "$AUTH_KEYS" ] || install -o root -g "$SERVICE_GROUP" -m 0640 /dev/null "$AUTH_KEYS"
    validate_managed_authorized_keys "$AUTH_KEYS" || \
        die 'authorized_keys contains an unmanaged or unrestricted entry'
    marker="dex-secret-miner-$miner_address"
    if awk -v blob="$key_blob" -v marker="$marker" '
        {
            for (i = 1; i <= NF; i++) {
                if ($i == blob && $NF != marker) duplicate = 1
            }
        }
        END { exit duplicate ? 0 : 1 }
    ' "$AUTH_KEYS"; then
        die 'this VPS fetch public key is already assigned to another miner address'
    fi

    slot_dir="$SECRET_ROOT/$miner_address"
    if [ "$authorize_only" -eq 1 ]; then
        [ -d "$slot_dir" ] || die "cannot authorize-only before secrets exist for $miner_address"
        [ ! -L "$slot_dir" ] || die 'miner secret slot must not be a symlink'
        [ -z "$private_key_file" ] && [ -z "$wrap_key_file" ] && [ "$generate_wrap" -eq 0 ] || usage
    else
        [ ! -e "$slot_dir" ] || die "$miner_address already exists; secrets will not be overwritten (use --authorize-only only to rotate the fetch key)"
        [ -n "$private_key_file" ] || usage
        [ -f "$private_key_file" ] || die "private key file not found: $private_key_file"
        [ ! -L "$private_key_file" ] || die 'private key file must not be a symlink'
        if [ "$generate_wrap" -eq 1 ] && [ -n "$wrap_key_file" ]; then
            usage
        fi
        if [ "$generate_wrap" -eq 0 ] && [ -z "$wrap_key_file" ]; then
            usage
        fi
        if [ -n "$wrap_key_file" ]; then
            [ -f "$wrap_key_file" ] || die "wrap key file not found: $wrap_key_file"
            [ ! -L "$wrap_key_file" ] || die 'wrap key file must not be a symlink'
        fi
    fi

    if [ "$authorize_only" -eq 0 ]; then
        command -v openssl >/dev/null 2>&1 || {
            [ "$generate_wrap" -eq 0 ] || die 'openssl is required to generate a wrap key'
        }
        install -d -o root -g "$SERVICE_GROUP" -m 0750 "$SECRET_ROOT"
        staging=$(mktemp -d "$SECRET_ROOT/.provision-${miner_address}.XXXXXX")
        cleanup_staging() {
            if [ -n "${staging:-}" ] && [ -d "$staging" ]; then
                rm -f -- "$staging/private_key.hex" "$staging/wrap_key.hex"
                rmdir -- "$staging" 2>/dev/null || true
            fi
        }
        trap cleanup_staging EXIT HUP INT TERM

        canonical_secret "$private_key_file" "$staging/private_key.hex" || die 'private key must be exactly 64 hexadecimal characters'
        if [ "$generate_wrap" -eq 1 ]; then
            openssl rand -hex 32 > "$staging/wrap_key.hex"
        else
            canonical_secret "$wrap_key_file" "$staging/wrap_key.hex" || die 'wrap key must be exactly 64 hexadecimal characters'
        fi

        private_value=$(cat -- "$staging/private_key.hex")
        wrap_value=$(cat -- "$staging/wrap_key.hex")
        [ "$private_value" != "$wrap_value" ] || die 'private key and wrap key must be independent values'
        private_value=
        wrap_value=

        chown root:"$SERVICE_GROUP" "$staging" "$staging/private_key.hex" "$staging/wrap_key.hex"
        chmod 0750 "$staging"
        chmod 0640 "$staging/private_key.hex" "$staging/wrap_key.hex"
        mv -- "$staging" "$slot_dir"
        staging=
        trap - EXIT HUP INT TERM
    fi

    auth_tmp=$(mktemp "$(dirname -- "$AUTH_KEYS")/.authorized_keys.XXXXXX")
    cleanup_auth() {
        [ -n "${auth_tmp:-}" ] && rm -f -- "$auth_tmp"
    }
    trap cleanup_auth EXIT HUP INT TERM

    awk -v marker="$marker" '$NF != marker { print }' "$AUTH_KEYS" > "$auth_tmp"
    forced_command="$CONTROL fetch $miner_address"
    if [ -n "$source_address" ]; then
        options="from=\"$source_address\",restrict,command=\"$forced_command\""
    else
        options="restrict,command=\"$forced_command\""
    fi
    printf '%s %s %s %s\n' "$options" "$key_type" "$key_blob" "$marker" >> "$auth_tmp"
    validate_managed_authorized_keys "$auth_tmp" || die 'generated authorized_keys entry failed validation'
    chown root:"$SERVICE_GROUP" "$auth_tmp"
    chmod 0640 "$auth_tmp"
    mv -f -- "$auth_tmp" "$AUTH_KEYS"
    auth_tmp=
    trap - EXIT HUP INT TERM

    secret_status=created
    [ "$authorize_only" -eq 0 ] || secret_status=untouched
    printf 'provisioned %s; signing secrets were %s\n' "$miner_address" "$secret_status"
    if [ "$generate_wrap" -eq 1 ]; then
        printf '%s\n' "back up $slot_dir/wrap_key.hex from the trusted server before starting DKG"
    fi
}

legacy_slot_error() {
    die 'legacy node-N secret authorization detected; automatic identity mapping is forbidden. Back up the slot, derive and verify its canonical fbc address, move it to /srv/dex-secrets/<fbc-address>, remove the legacy authorized_keys/grant entry, then run provision --authorize-only --miner-address <fbc-address>'
}

cmd_validate_install_state() {
    require_root
    [ "$#" -eq 0 ] || usage
    [ -f "$AUTH_KEYS" ] || die "missing authorized_keys: $AUTH_KEYS"
    [ ! -L "$AUTH_KEYS" ] || die 'authorized_keys must not be a symlink'
    lock_state
    [ ! -L "$SECRET_ROOT" ] || die 'secret root must not be a symlink'
    [ ! -L "$GRANT_ROOT" ] || die 'grant root must not be a symlink'
    if grep -Eq 'dex-secret-node-|fetch[[:space:]]+node-|dex-secret-broker' "$AUTH_KEYS"; then
        legacy_slot_error
    fi
    for legacy_path in "$SECRET_ROOT"/node-* "$GRANT_ROOT"/node-*.expires; do
        if [ -e "$legacy_path" ] || [ -L "$legacy_path" ]; then
            legacy_slot_error
        fi
    done
    for slot_path in "$SECRET_ROOT"/*; do
        if [ ! -e "$slot_path" ] && [ ! -L "$slot_path" ]; then
            continue
        fi
        slot_name=${slot_path##*/}
        require_canonical_miner_address "$slot_name" >/dev/null 2>&1 || \
            die "secret slot is not named by a canonical fbc address: $slot_name"
        [ -d "$slot_path" ] && [ ! -L "$slot_path" ] || \
            die "miner secret slot must be a real directory: $slot_name"
    done
    for grant_path in "$GRANT_ROOT"/*.expires; do
        if [ ! -e "$grant_path" ] && [ ! -L "$grant_path" ]; then
            continue
        fi
        grant_name=${grant_path##*/}
        grant_address=${grant_name%.expires}
        require_canonical_miner_address "$grant_address" >/dev/null 2>&1 || \
            die "grant is not named by a canonical fbc address: $grant_name"
        [ -f "$grant_path" ] && [ ! -L "$grant_path" ] || \
            die "miner grant must be a real file: $grant_name"
    done
    validate_managed_authorized_keys "$AUTH_KEYS" || \
        die 'authorized_keys contains an unmanaged, unrestricted, or non-fbc-address entry'
}

subcommand=${1:-}
[ -n "$subcommand" ] || usage
shift
case "$subcommand" in
    fetch) cmd_fetch "$@" ;;
    allow) cmd_allow "$@" ;;
    revoke) cmd_revoke "$@" ;;
    provision) cmd_provision "$@" ;;
    validate-install-state) cmd_validate_install_state "$@" ;;
    -h|--help|help) usage ;;
    *) usage ;;
esac
