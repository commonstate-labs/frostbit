# Default-deny the build context. Docker sends context files to the builder
# even when Dockerfile never COPYs them, so the allowlist is the real boundary.
**
!Dockerfile
!.dockerignore
!LICENSE
!NOTICE
!go.mod
!go.sum

!blocktrace/
!blocktrace/**
!certchain/
!certchain/**
!cmd/
!cmd/main/
!cmd/main/**
!cmd/explorer/
!cmd/explorer/**
!cmd/miner-register/
!cmd/miner-register/**
!config/
!config/*.go
!consensus/
!consensus/**
!crt/
!crt/**
!db/
!db/**
!frost/
!frost/**
!future/
!future/**
!handlers/
!handlers/**
!interfaces/
!interfaces/**
!keys/
!keys/**
!lifecycle/
!lifecycle/**
!liveness/
!liveness/**
!logs/
!logs/**
!pb/
!pb/**
!protocol/
!protocol/**
!referral/
!referral/**
!rent/
!rent/**
!sender/
!sender/**
!stateDB/
!stateDB/**
!stats/
!stats/**
!txpool/
!txpool/**
!txverify/
!txverify/**
!types/
!types/**
!utils/
!utils/**
!vm/
!vm/**
!witness/
!witness/**

!explorer/
!explorer/package.json
!explorer/package-lock.json
!explorer/index.html
!explorer/style.css
!explorer/tsconfig.json
!explorer/vite.config.ts
!explorer/public/
!explorer/public/**
!explorer/src/
!explorer/src/**

!deploy/
!deploy/container-node-entrypoint.sh

# Redundant, explicit high-risk exclusions retained as reviewable contract.
.git
.agent/
.agents/
.claude/
.idea/
.vscode
.gocache*/
.tmp-go*/
.local/
$profile
AGENTS.md
CLAUDE.md
task.md
promote.md
production_readiness_gap_report.md
data
explorer_data
config/env/
deploy/physical20/
dist
bin
run
tmp/
tem/
log.txt
*.exe
*.exe~
*debug_bin*
*.pem
*.key
*.crt
*.p12
*.pfx
*.env
.env
.env.*
.env*
*.pprof
*.pb.gz
*.log
*.txt
coverage
coverage/
