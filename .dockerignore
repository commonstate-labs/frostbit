wallet/node_modules
wallet/dist
solidity/artifacts
solidity/cache
solidity/node_modules

# sender/ is re-included for Go sources above, so transaction captures need a
# final exclusion after every allow rule. Keep both exact and recursive forms.
sender/tx_data.jsonl
*.jsonl
**/*.jsonl
